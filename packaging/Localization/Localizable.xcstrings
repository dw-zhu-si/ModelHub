    "%arg 个模型 · 聊天在线检测；生成模型显示原生协议入口" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نماذج %arg · اكتشاف الدردشة عبر الإنترنت؛ يعرض النموذج الذي تم إنشاؤه إدخال البروتوكول الأصلي"
