    "Token Plan 个人版；必须使用个人版专属 API Key，不能与按量付费、Coding Plan 或团队版混用。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإصدار الشخصي من Token Plan؛ يجب استخدام مفتاح API الشخصي المخصص، ولا يمكن خلطه مع الدفع حسب الاستخدام أو Coding Plan أو إصدار الفريق." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Personal: Verwenden Sie den dafür vorgesehenen API-Schlüssel; er darf nicht mit Pay-as-you-go, Coding Plan oder der Team-Version gemischt werden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Personal: use its dedicated API key; it cannot be mixed with pay-as-you-go, Coding Plan, or the Team edition." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Personal: use su clave API dedicada; no se puede combinar con pago por uso, Coding Plan ni la edición para equipos." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Personnel : utilisez sa clé API dédiée ; elle ne peut pas être mélangée avec le paiement à l’usage, Coding Plan ou l’édition Équipe." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan 個人版では専用 API Key を使用してください。従量課金、Coding Plan、チーム版のキーとは併用できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan 개인 버전은 전용 API Key를 사용해야 하며 종량제, Coding Plan 또는 팀 버전과 혼용할 수 없습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Pessoal: use a chave de API dedicada; ela não pode ser combinada com pagamento conforme o uso, Coding Plan ou a edição para equipes." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Personal: используйте выделенный API-ключ; его нельзя смешивать с оплатой по мере использования, Coding Plan или командной версией." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan 个人版；必须使用个人版专属 API Key，不能与按量付费、Coding Plan 或团队版混用。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan 個人版；必須使用個人版專屬 API Key，不能與按量付費、Coding Plan 或團隊版混用。" } }
      }
    },
    "Token Plan 团队版；必须使用分配席位后生成的团队版专属 API Key，不能与企业业务空间按量付费 Key 混用。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إصدار Token Plan للفرق؛ يجب استخدام مفتاح API المخصص للفريق الذي تم إنشاؤه بعد تعيين المقعد، ولا يمكن خلطه مع مفتاح الدفع حسب الاستخدام لمساحة عمل المؤسسة." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Team: Verwenden Sie den nach der Sitzplatzzuweisung erzeugten Team-API-Schlüssel; er darf nicht mit einem Pay-as-you-go-Schlüssel für Unternehmens-Arbeitsbereiche gemischt werden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Team: use the dedicated team API key generated after assigning a seat; it cannot be mixed with an enterprise workspace pay-as-you-go key." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan para equipos: use la clave API de equipo generada tras asignar una plaza; no se puede combinar con una clave de pago por uso del espacio empresarial." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Équipe : utilisez la clé API d’équipe générée après l’attribution d’un siège ; elle ne peut pas être mélangée avec une clé de paiement à l’usage d’un espace de travail d’entreprise." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan チーム版では、シート割り当て後に生成した専用 API Key を使用してください。企業ワークスペースの従量課金 Key とは併用できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan 팀 버전은 좌석 할당 후 생성된 팀 전용 API Key를 사용해야 하며 기업 워크스페이스 종량제 Key와 혼용할 수 없습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan para equipes: use a chave de API da equipe gerada após atribuir um assento; ela não pode ser combinada com uma chave de pagamento conforme o uso do espaço empresarial." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan Team: используйте командный API-ключ, созданный после назначения места; его нельзя смешивать с ключом корпоративного рабочего пространства с оплатой по мере использования." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan 团队版；必须使用分配席位后生成的团队版专属 API Key，不能与企业业务空间按量付费 Key 混用。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Token Plan 團隊版；必須使用分配席位後產生的團隊版專屬 API Key，不能與企業業務空間按量付費 Key 混用。" } }
      }
    },
    "；目录同时提供可自动同步的 Token 价格。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "؛ يوفر الدليل أيضًا أسعار الرموز القابلة للمزامنة تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; der Katalog enthält auch automatisch synchronisierbare Tokenpreise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; the catalog also provides token prices that can be synchronized automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; el catálogo también proporciona precios de tokens que se pueden sincronizar automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ; le catalogue fournit aussi des tarifs de jetons synchronisables automatiquement."
          }
        },
        "ja" : {
