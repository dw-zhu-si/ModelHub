        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de demonstração de auditoria não iniciará o teste do modelo; o estado de saúde atual consiste em dados de demonstração sintéticos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим демонстрации аудита не инициирует тестирование модели; текущее состояние здоровья представляет собой синтетические демонстрационные данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
