    "Agent 令牌的钥匙串访问被拒绝；后台不会重复弹出授权窗口。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض وصول سلسلة المفاتيح إلى رمز Agent. لن تطلبه المهام الخلفية مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbundzugriff für das Agent-Token wurde verweigert. Hintergrundaufgaben fragen nicht erneut nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain access for the Agent token was denied. Background tasks will not ask again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso al llavero para el token de Agent. Las tareas en segundo plano no volverán a solicitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au trousseau pour le jeton Agent a été refusé. Les tâches en arrière-plan ne le redemanderont pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentトークンへのキーチェーンアクセスが拒否されました。バックグラウンドでは再度確認しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 토큰의 키체인 접근이 거부되었습니다. 백그라운드에서는 다시 묻지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às Chaves para o token do Agent foi negado. As tarefas em segundo plano não solicitarão novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к Связке ключей для токена Agent отклонён. Фоновые задачи больше не будут запрашивать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 令牌的钥匙串访问被拒绝；后台不会重复弹出授权窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 令牌的鑰匙串訪問被拒絕；後台不會重復彈出授權窗口。"
          }
        }
      }
    },
    "Agent 令牌需要重新授权；后台检查不会弹出授权窗口。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج رمز Agent إلى إعادة تفويض سلسلة المفاتيح. لن تعرض عمليات التحقق الخلفية مطالبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Agent-Token muss im Schlüsselbund erneut autorisiert werden. Hintergrundprüfungen zeigen keinen Dialog an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Agent token needs Keychain authorization again. Background checks will not show a prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token de Agent necesita autorización del llavero de nuevo. Las comprobaciones en segundo plano no mostrarán avisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton Agent doit être de nouveau autorisé dans le trousseau. Les vérifications en arrière-plan n’afficheront pas d’invite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentトークンにはキーチェーンの再承認が必要です。バックグラウンド確認ではダイアログを表示しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 토큰에 키체인 재승인이 필요합니다. 백그라운드 확인에서는 대화상자를 표시하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token do Agent precisa ser autorizado novamente nas Chaves. As verificações em segundo plano não mostrarão avisos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токен Agent необходимо повторно разрешить в Связке ключей. Фоновые проверки не показывают запрос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 令牌需要重新授权；后台检查不会弹出授权窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 令牌需要重新授權；後台檢查不會彈出授權窗口。"
          }
        }
      }
    },
