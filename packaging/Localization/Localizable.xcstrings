          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связка ключей отклонила доступ. Разрешите доступ один раз при показе или копировании токена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串拒绝了访问；请在主动显示或复制令牌时确认一次访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑰匙串拒絕了訪問；請在主動顯示或複製令牌時確認一次訪問權限。"
          }
        }
      }
    },
