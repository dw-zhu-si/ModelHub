          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Байлианская версия была изменена. Чтобы избежать повторного использования несовместимых учетных данных, перед сохранением введите ключ API, соответствующий новой версии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
