        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèles %arg · Détection de chat en ligne ; le modèle généré affiche l'entrée de protocole native"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg モデル · チャット オンライン検出。生成されたモデルにはネイティブ プロトコル エントリが表示されます"
