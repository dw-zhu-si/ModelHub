    "温暖、轻快的钢琴与弦乐，适合清晨。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيانو والأوتار الدافئة والمتجددة الهواء، مثالية للصباح الباكر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warmes, luftiges Klavier und Streicher, perfekt für den frühen Morgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm, airy piano and strings, perfect for the early morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano y cuerdas cálidos y aireados, perfectos para temprano en la mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano et cordes chaleureux et aérés, parfaits pour le petit matin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暖かく軽やかなピアノとストリングスが早朝にぴったりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따뜻하고 바람이 잘 통하는 피아노와 현악기는 이른 아침에 딱 맞습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano e cordas quentes e arejados, perfeitos para o início da manhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теплое, воздушное фортепиано и струнные, идеальное для раннего утра."
