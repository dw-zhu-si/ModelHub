        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg models · chat models are tested online; generative models show their native protocol"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos %arg · Detección de chat en línea; El modelo generado muestra la entrada del protocolo nativo."
