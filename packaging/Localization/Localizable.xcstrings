    "%arg 个模型 · 聊天模型在线检测；生成模型未通过原生验证时保持隔离" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg نموذجًا · اختبار نماذج الدردشة عبر الإنترنت؛ تبقى نماذج التوليد معزولة حتى تجتاز التحقق الأصلي"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg Modelle · Chatmodelle werden online getestet; generative Modelle bleiben bis zur nativen Verifizierung isoliert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg models · chat models are tested online; generative models stay quarantined until native verification passes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg modelos · los modelos de chat se prueban en línea; los modelos generativos permanecen aislados hasta superar la verificación nativa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg modèles · les modèles de chat sont testés en ligne ; les modèles génératifs restent isolés jusqu’à validation native"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg モデル · チャットモデルはオンラインでテストされ、生成モデルはネイティブ検証に合格するまで隔離されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg개 모델 · 채팅 모델은 온라인으로 테스트되며 생성 모델은 기본 프로토콜 검증을 통과할 때까지 격리됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg modelos · modelos de chat são testados online; modelos generativos ficam isolados até passarem pela verificação nativa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%arg моделей · чат-модели тестируются онлайн; генеративные модели остаются изолированными до прохождения нативной проверки"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$arg 个模型 · 聊天模型在线检测；生成模型未通过原生验证时保持隔离"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
