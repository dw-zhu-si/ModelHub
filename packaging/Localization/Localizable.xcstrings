        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервная копия импортирована. Для отмены нажмите «Восстановить конфигурацию до последнего импорта»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
