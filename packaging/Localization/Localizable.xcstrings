    "当前地址属于百炼 Token Plan，请将供应商类型改为“百炼个人版”或“百炼企业版（团队版）”。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العنوان الحالي ينتمي إلى Bailian Token Plan، يرجى تغيير نوع المورد إلى \"Bailian Personal Edition\" أو \"Bailian Enterprise Edition (Team Edition)\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Adresse gehört zum Bailian Token Plan. Bitte ändern Sie den Lieferantentyp in „Bailian Personal Edition“ oder „Bailian Enterprise Edition (Team Edition)“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current address belongs to Bailian Token Plan, please change the supplier type to \"Bailian Personal Edition\" or \"Bailian Enterprise Edition (Team Edition)\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección actual pertenece al Plan Bailian Token. Cambie el tipo de proveedor a \"Bailian Personal Edition\" o \"Bailian Enterprise Edition (Team Edition)\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse actuelle appartient au Bailian Token Plan, veuillez changer le type de fournisseur en « Bailian Personal Edition » ou « Bailian Enterprise Edition (Team Edition) »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアドレスは Bailian トークン プランに属しています。サプライヤー タイプを「Bailian Personal Edition」または「Bailian Enterprise Edition (Team Edition)」に変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 주소는 Bailian Token Plan에 속해 있습니다. 공급업체 유형을 \"Bailian Personal Edition\" 또는 \"Bailian Enterprise Edition(Team Edition)\"으로 변경하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço atual pertence ao Bailian Token Plan, altere o tipo de fornecedor para \"Bailian Personal Edition\" ou \"Bailian Enterprise Edition (Team Edition)\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий адрес принадлежит плану Bailian Token Plan, измените тип поставщика на «Bailian Personal Edition» или «Bailian Enterprise Edition (Team Edition)»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前地址属于百炼 Token Plan，请将供应商类型改为“百炼个人版”或“百炼企业版（团队版）”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前地址屬於百鍊 Token Plan，請將供應商類型改為“百鍊個人版”或“百鍊企業版（團隊版）”。"
          }
        }
      }
    },
    "当前密钥不会显示。输入新密钥并保存即可覆盖；留空会保留原密钥。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتم عرض المفتاح الحالي. أدخل مفتاحًا جديدًا واحفظه للكتابة فوقه؛ سيؤدي تركه فارغًا إلى الاحتفاظ بالمفتاح الأصلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Schlüssel wird nicht angezeigt. Geben Sie einen neuen Schlüssel ein und speichern Sie ihn, um ihn zu überschreiben. Wenn Sie das Feld leer lassen, bleibt der Originalschlüssel erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current key will not be displayed. Enter a new key and save it to overwrite it; leaving it blank will retain the original key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave actual no se mostrará. Ingrese una nueva clave y guárdela para sobrescribirla; dejarlo en blanco conservará la clave original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé actuelle ne sera pas affichée. Entrez une nouvelle clé et enregistrez-la pour l'écraser ; le laisser vide conservera la clé d’origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のキーは表示されません。新しいキーを入力して保存し、上書きします。空白のままにすると、元のキーが保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 키는 표시되지 않습니다. 새 키를 입력하고 저장하여 덮어씁니다. 공백으로 두면 원래 키가 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave atual não será exibida. Insira uma nova chave e salve-a para substituí-la; deixá-lo em branco manterá a chave original."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий ключ не будет отображаться. Введите новый ключ и сохраните его, чтобы перезаписать; если оставить это поле пустым, исходный ключ сохранится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前密钥不会显示。输入新密钥并保存即可覆盖；留空会保留原密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前密鑰不會顯示。輸入新密鑰並保存即可覆蓋；留空會保留原密鑰。"
          }
        }
      }
    },
    "当前应用包不支持登录启动，请使用已安装的签名版本" : {
