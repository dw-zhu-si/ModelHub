          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format per line: endpoint type | model name = full URL. Only the full address saved here or in the Base URL is used at runtime without any path completion; video and music task endpoints can use {task_id}."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato por línea: tipo de punto final | nombre del modelo = URL completa. Sólo la dirección completa guardada aquí o en la URL base se utiliza en tiempo de ejecución sin completar ninguna ruta; Los puntos finales de tareas de vídeo y música pueden utilizar {task_id}."
          }
        },
        "fr" : {
          "stringUnit" : {
