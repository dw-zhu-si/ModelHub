{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "“%@”已解除隔离并恢复路由。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحرير \"%@\" من العزل وتمت استعادة التوجيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde aus der Quarantäne freigegeben und die Weiterleitung wurde wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" has been released from quarantine and routing has been restored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ha sido liberado de la cuarentena y se ha restaurado el enrutamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" a été libéré de la quarantaine et le routage a été restauré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は隔離から解放され、ルーティングが復元されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"이(가) 격리에서 해제되었으며 라우팅이 복원되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" foi liberado da quarentena e o roteamento foi restaurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" вышел из карантина, и маршрутизация восстановлена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已解除隔离并恢复路由。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已解除隔離並恢復路由。"
          }
        }
      }
    },
    "“%@”的 API Key 已删除，所属模型已隔离。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف مفتاح واجهة برمجة التطبيقات \"%@\" وتم عزل النموذج الذي ينتمي إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Schlüssel „%@“ wurde gelöscht und das Modell, zu dem er gehört, wurde isoliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API Key of \"%@\" has been deleted and the model it belongs to has been isolated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha eliminado la clave API de \"%@\" y se ha aislado el modelo al que pertenece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API de \"%@\" a été supprimée et le modèle auquel elle appartient a été isolé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の API キーが削除され、所属するモデルが分離されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"의 API 키가 삭제되었으며 해당 키가 속한 모델이 격리되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave API de \"%@\" foi excluída e o modelo ao qual ela pertence foi isolado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API «%@» был удален, а модель, к которой он принадлежит, изолирована."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的 API Key 已删除，所属模型已隔离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的 API Key 已刪除，所屬模型已隔離。"
          }
        }
      }
    },
    "“%@”的 API Key 已安全更新；既有隔离记录保持不变。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحديث مفتاح واجهة برمجة التطبيقات لـ '%@' بأمان؛ تظل سجلات الحجر الصحي الحالية دون تغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Schlüssel für „%@“ wurde sicher aktualisiert; bestehende Quarantäneeinträge bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API Key for '%@' has been safely updated; existing quarantine records remain unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave API para '%@' se ha actualizado de forma segura; Los registros de cuarentena existentes permanecen sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API pour '%@' a été mise à jour en toute sécurité ; les enregistrements de quarantaine existants restent inchangés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の API キーは安全に更新されました。既存の隔離記録は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'에 대한 API 키가 안전하게 업데이트되었습니다. 기존 검역 기록은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de API para '%@' foi atualizada com segurança; os registros de quarentena existentes permanecem inalterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API для «%@» безопасно обновлен; существующие карантинные записи остаются неизменными."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的 API Key 已安全更新；既有隔离记录保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的 API Key 已安全更新；既有隔離記錄保持不變。"
          }
        }
      }
    },
