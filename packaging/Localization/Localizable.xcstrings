    "优先级故障转移" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوز الأعطال حسب الأولوية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritäts-Failover"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priority Failover"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conmutación por prioridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculement par priorité"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先順位フェイルオーバー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우선순위 장애 조치"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failover por prioridade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отказоустойчивость по приоритету"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先级故障转移"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先級故障轉移"
          }
        }
      }
    },
    "优先级数值越小越先尝试；权重仅用于权重随机策略。5xx、429 或网络错误会触发故障转移。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلما كانت قيمة الأولوية أصغر، المحاولة الأولى؛ يتم استخدام الوزن فقط لاستراتيجية الوزن العشوائية. تؤدي أخطاء 5xx أو 429 أو أخطاء الشبكة إلى تجاوز الفشل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kleiner der Prioritätswert ist, desto größer ist der erste Versuch. Das Gewicht wird nur für die Weight-Random-Strategie verwendet. 5xx-, 429- oder Netzwerkfehler lösen ein Failover aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower priority values are tried first. Weights apply only to weighted-random routing. HTTP 5xx, 429, and network errors trigger failover."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto menor sea el valor de prioridad, el primer intento; el peso solo se usa para la estrategia aleatoria de peso. Los errores 5xx, 429 o de red desencadenan la conmutación por error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus la valeur de priorité est petite, c'est le premier essai ; le poids n'est utilisé que pour la stratégie de poids aléatoire. Les erreurs 5xx, 429 ou réseau déclenchent le basculement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先順位の値が小さいほど、最初の試行が行われます。重みは重みランダム戦略にのみ使用されます。 5xx、429、またはネットワーク エラーがフェイルオーバーをトリガーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우선순위 값이 작을수록 첫 번째 시도입니다. 가중치는 가중치 무작위 전략에만 사용됩니다. 5xx, 429 또는 네트워크 오류가 장애 조치를 트리거합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto menor o valor da prioridade, primeira tentativa; o peso é usado apenas para a estratégia aleatória de peso. Erros 5xx, 429 ou de rede acionam o failover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем меньше значение приоритета, тем первая попытка; вес используется только для стратегии случайного веса. 5xx, 429 или сетевые ошибки запускают аварийное переключение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先级数值越小越先尝试；权重仅用于权重随机策略。5xx、429 或网络错误会触发故障转移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先級數值越小越先嘗試；權重僅用於權重隨機策略。5xx、429 或網絡錯誤會觸發故障轉移。"
          }
        }
      }
    },
